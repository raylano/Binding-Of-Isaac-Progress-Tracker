# Poort op de server (alleen localhost; nginx zit ervoor)
PORT=8090

# Code voor het slot op de deur. Vul hier je eigen PIN in.
ACCESS_PIN=

# Geheim waarmee de inlogcookie wordt ondertekend. Leeg = wordt eenmalig
# gegenereerd en bewaard in data/.session-secret. Maak er zelf een met:
#   openssl rand -hex 32
SESSION_SECRET=

# Jouw Steam-profiel (SteamID64, 17 cijfers) voor de Steam-sync. Te vinden op
# steamid.io, of: 76561197960265728 + het nummer van je map in Steam\userdata.
STEAM_ID=

# Optioneel: Steam Web API-sleutel (https://steamcommunity.com/dev/apikey).
# Zonder sleutel gebruikt de server de publieke profielpagina. Beide werken
# alleen als "Game details" in je Steam-privacy op Openbaar staat.
STEAM_API_KEY=

# Achter nginx: 1. Lokaal zonder proxy: 0.
TRUST_PROXY=1
