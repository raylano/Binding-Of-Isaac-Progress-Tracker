# Poort op de server (alleen localhost; nginx zit ervoor)
PORT=8090

# Iedereen logt in met een eigen account (e-mail + wachtwoord).
#
# Alleen voor de overstap van de oude PIN: staat er nog voortgang in
# data/progress.json, vul dan hier de oude PIN in. De eigenaar kan die voortgang
# daarmee één keer naar zijn account halen. Leeg = overnemen staat uit.
ACCESS_PIN=

# SteamID64 van de oude eigenaar. Gaat bij het overnemen mee naar dat account;
# alle anderen vullen hun eigen SteamID in op de Sync-pagina.
STEAM_ID=

# Optioneel: Steam Web API-sleutel (https://steamcommunity.com/dev/apikey).
# Zonder sleutel gebruikt de server de publieke profielpagina. Beide werken
# alleen als "Game details" in je Steam-privacy op Openbaar staat.
STEAM_API_KEY=

# Achter nginx: 1. Lokaal zonder proxy: 0.
TRUST_PROXY=1
