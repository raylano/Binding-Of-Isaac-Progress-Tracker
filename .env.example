# BasementDiary settings. Copy to .env and fill in; .env is never committed.
# Every value below is a placeholder: do not put real secrets in this file.

# Host port. Docker publishes it on 127.0.0.1 only; nginx sits in front.
# For local development (npm run dev) this is also the port the app listens on.
PORT=8090

# Public address players use, without a trailing slash. Shown in the
# sync-script command on the Sync page. HTTPS only (HTTP is allowed for
# localhost while developing). Leave empty to use whatever the browser shows.
PUBLIC_URL=https://your-domain.example

# The account with this email address is the admin: it can open and close
# registration on the Sync page. Registration is closed by default.
ADMIN_EMAIL=admin@example.com

# ONE-TIME: creates the admin account on the first start if it does not exist
# yet (at least 12 characters). Only the hash is stored. Remove this line again
# after the first start and recreate the container (docker compose up -d).
ADMIN_PASSWORD=

# Optional: Steam Web API key (https://steamcommunity.com/dev/apikey).
# Without a key the server reads the public profile page. Both only work if
# "Game details" is set to Public in the player's Steam privacy settings.
STEAM_API_KEY=

# Behind nginx (one proxy): 1. Locally without a proxy: 0.
TRUST_PROXY=1
